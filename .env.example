# Core Runtime
GTM_ENV=sandbox                           # sandbox | production
GTM_LIVE_SEND_ENABLED=false               # Hard killswitch for real outbound emails
GTM_REQUIRE_APPROVAL_ALL=true             # Forces APPROVE tier on all emails when true
LOG_LEVEL=INFO

# Datastores
# If a local PostgreSQL already uses 5432, set PG_PORT=55432 and use that port here
PG_PORT=5432
DATABASE_URL=postgresql+asyncpg://gtm:gtm_pass@localhost:5432/gtm_platform
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_pass

# LLMs & Embeddings
ANTHROPIC_API_KEY=mock                    # set a real key for live Claude calls
LLM_PRIMARY_MODEL=claude-sonnet-5-5
LLM_JUDGE_MODEL=claude-haiku-5-5
EMBEDDING_PROVIDER=hash                   # hash (deterministic, offline) | local_fastembed | openai

# GTM Integrations (leave as 'mock' to use deterministic sandbox fixtures)
APOLLO_API_KEY=mock
CLAY_WEBHOOK_URL=http://localhost:8000/webhooks/mock-clay
CLAY_SIGNING_SECRET=local_clay_secret
HUBSPOT_PRIVATE_APP_TOKEN=mock
SALESFORCE_CLIENT_ID=mock
SALESFORCE_CLIENT_SECRET=mock
SALESFORCE_USERNAME=mock
SALESFORCE_PASSWORD=mock
SALESFORCE_SECURITY_TOKEN=mock
N8N_WEBHOOK_SECRET=local_n8n_secret
SLACK_BOT_TOKEN=xoxb-mock
SLACK_SIGNING_SECRET=mock_slack_secret
SLACK_APPROVAL_CHANNEL_ID=C00000000

# Compliance
UNSUBSCRIBE_JWT_SECRET=change_me_to_a_32_byte_random_string
UNSUBSCRIBE_BASE_URL=http://localhost:8000
SENDER_POSTAL_ADDRESS=123 Example St, Suite 100, San Francisco, CA 94105, USA

# Observability
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
